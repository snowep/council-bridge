# Council Bridge Configuration
# Copy to .env and adjust values as needed

# Server
PORT=3334
NODE_ENV=development

# Database
# DATABASE_PATH=/path/to/council.db  (required in production)

# Authentication Mode: development | production
AUTH_MODE=development

# Session secret for production (required in production)
# SESSION_SECRET=your-secure-random-secret-here

# Local Single-User Founder Mode
# When enabled:
# - Auto-authenticates as Founder on loopback connections
# - Binds server to 127.0.0.1 (localhost only)
# - Removes login page from frontend
# - No manual authentication required
LOCAL_SINGLE_USER_MODE=true
LOCAL_SINGLE_USER_BIND_ADDRESS=127.0.0.1

# Frontend
VITE_API_BASE_URL=
VITE_LOCAL_SINGLE_USER_MODE=true